@using Microsoft.AspNetCore.Identity

@namespace EPAS.Components.Components.Account.Shared
@inject SignInManager<ApplicationUser> SignInManager

<div class="fro-list">
    <a href="/Account/Manage" class="fro-list-item">
        <i class="fro-icon fro-list-item__icon" translate="no">user</i>
        <div class="fro-list-item__label">Profil</div>
    </a>
    <a href="/Account/Manage/Email" class="fro-list-item">
        <i class="fro-icon fro-list-item__icon" translate="no">envelope</i>
        <div class="fro-list-item__label">Email</div>
    </a>
    <a href="/Account/Manage/ChangePassword" class="fro-list-item">
        <i class="fro-icon fro-list-item__icon" translate="no">lock_keyhole</i>
        <div class="fro-list-item__label">Passwort</div>
    </a>
@if (hasExternalLogins)
    {
        <a href="/Account/Manage/ExternalLogins" class="fro-list-item">
            <i class="fro-icon fro-list-item__icon" translate="no">globe</i>
            <div class="fro-list-item__label">External Logins</div>
        </a>
    }
    <a href="/Account/Manage/TwoFactorAuthentication" class="fro-list-item">
        <i class="fro-icon fro-list-item__icon" translate="no">phone</i>
        <div class="fro-list-item__label">Two-factor Authentication</div>
    </a>
    <a href="/Account/Manage/PersonalData" class="fro-list-item">
        <i class="fro-icon fro-list-item__icon" translate="no">person</i>
        <div class="fro-list-item__label">Personal Data</div>
    </a>
</div>

@code {
    private bool hasExternalLogins;

    protected override async Task OnInitializedAsync()
    {
        hasExternalLogins = (await SignInManager.GetExternalAuthenticationSchemesAsync()).Any();
    }

}