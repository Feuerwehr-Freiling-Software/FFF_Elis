@page "/Account/Manage/PersonalData"

@inject IdentityUserAccessor UserAccessor

<PageTitle>Persönliche Daten</PageTitle>

<StatusMessage/>
<h3>Persönliche Daten</h3>

<div class="row">
    <div class="col-md-6">
        <p>Ihr Konto enthält personenbezogene Daten, die Sie uns zur Verfügung gestellt haben. Auf dieser Seite können Sie diese Daten herunterladen oder löschen.</p>
        <p>
            <strong>Durch das Löschen dieser Daten wird Ihr Konto dauerhaft entfernt und kann nicht wiederhergestellt werden.</strong>
        </p>
        <div class="d-flex align-items-center" style="padding-top: 15px;">
            <form action="Account/Manage/DownloadPersonalData" method="post" class="me-3">
                <AntiforgeryToken/>
                <button class="fro-button fro-button--primary" type="submit">Herunterladen</button>
            </form>
            <p>
                <a href="Account/Manage/DeletePersonalData" class="fro-button fro-button--cta">Löschen</a>
            </p>
        </div>
    </div>
</div>

@code {
    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        _ = await UserAccessor.GetRequiredUserAsync(HttpContext);
    }

}